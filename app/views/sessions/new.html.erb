<div class="page-header mb-4">
  <h1 class="h2">Log in</h1>
</div>

<%= tag.div(flash[:alert], class: "alert alert-danger alert-dismissible fade show", role: "alert") if flash[:alert] %>
<%= tag.div(flash[:notice], class: "alert alert-success alert-dismissible fade show", role: "alert") if flash[:notice] %>

<%= form_with url: signin_path do |f| %>
  <div class="field mb-3">
    <%= f.label :login, "Username or email", class: 'form-label' %>
    <%= f.text_field :login, name: 'login', autofocus: true, class: 'form-control' %>
  </div>

  <div class="field mb-3">
    <%= f.label :password, class: 'form-label' %>
    <%= f.password_field :password, name: 'password', autocomplete: "off", class: 'form-control' %>
  </div>

  <div class="actions">
    <%= f.submit "Log in", class: 'btn btn-primary' %>
  </div>
<% end %>

<div class="mt-3">
  <%= link_to 'Forgot password?', new_password_path, class: 'text-decoration-none' %>
</div>
