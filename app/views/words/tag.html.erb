<%= content_for(:title) { @tag } %>

<div class="page-header">
  <h1><%= @tag %></h1>
</div>

<div class="list-group">
  <% @words.each do |word| %>
    <%= link_to word, class: 'list-group-item' do %>
      <h4 class="list-group-item-heading"><%= word.title %></h4>
      <p class="list-group-item-text"><%= word.body.to_plain_text.truncate(100, omission: '...') %></p>
    <% end %>
  <% end %>
</div>
