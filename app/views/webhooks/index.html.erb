<h1 class="page-header mb-4 h2">Listing webhooks</h1>

<ul class="list-group">
  <% @webhooks.each do |webhook| %>
    <li class="list-group-item clearfix">
      <%= webhook.title %>
      <p class="text-muted">
        <%= webhook.url %>
      </p>
      <div class="float-end">
        <div class="btn-group">
          <%= link_to 'Edit', edit_webhook_path(webhook), method: :get, class: 'btn btn-outline-primary btn-sm' %>
          <%= link_to 'Destroy', webhook, data: { turbo_confirm: 'Are you sure?' }, method: :delete, class: 'btn btn-outline-danger btn-sm' %>
        </div>
      </div>
    </li>
  <% end %>
</ul>

<br>

<%= link_to 'New Webhook', new_webhook_path, class: 'btn btn-primary' %>
